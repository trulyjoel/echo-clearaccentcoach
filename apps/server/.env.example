PORT=3000

# Clerk (https://dashboard.clerk.com) — create an app, then under
# User & authentication > Email, phone, username: disable Password,
# enable "Email verification link" for both sign-up and sign-in.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Origin allowed to call this server's API in dev/prod (the deployed apps/web URL)
WEB_ORIGIN=http://localhost:5173

# Postgres connection string (Neon in prod; local Postgres in dev), accessed via Drizzle ORM
DATABASE_URL=

# Deepgram (https://console.deepgram.com) — used for live speech-to-text streaming
DEEPGRAM_API_KEY=
