PORT=3000

# Clerk (https://dashboard.clerk.com) — create an app, then under
# User & authentication > Email, phone, username: disable Password,
# enable "Email verification link" for both sign-up and sign-in.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Origin allowed to call this server's API in dev/prod (the deployed apps/web URL)
WEB_ORIGIN=http://localhost:5173

# Postgres connection string (Neon in prod; local Postgres in dev), accessed via Drizzle ORM
DATABASE_URL=

# Deepgram (https://console.deepgram.com) — used for live speech-to-text streaming
DEEPGRAM_API_KEY=

# Anthropic (https://console.anthropic.com) — used for Callie's conversational replies
ANTHROPIC_API_KEY=
# Model ID to use for replies. Optional — defaults to claude-sonnet-5.
LLM_MODEL=

# ElevenLabs (https://elevenlabs.io) — used to synthesize Callie's spoken replies
ELEVENLABS_API_KEY=
# Voice ID to use for Callie. Optional — defaults to the "Rachel" premade voice.
ELEVENLABS_VOICE_ID=

# Max minutes a session may run before the server auto-ends it. Optional — defaults to 15.
MAX_SESSION_DURATION_MINUTES=
# Soft cap on sessions a single user may start per UTC day. Optional — defaults to 10.
DAILY_SESSION_CAP=

# Cloudflare R2 (https://dash.cloudflare.com, R2 tab) — stores flagged-error audio clips.
# Create a bucket and an R2 API token scoped to it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
