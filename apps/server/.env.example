PORT=3000

# Clerk (https://dashboard.clerk.com) — create an app, then under
# User & authentication > Email, phone, username: disable Password,
# enable "Email verification link" for both sign-up and sign-in.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Origin allowed to call this server's API in dev/prod (the deployed apps/web URL)
WEB_ORIGIN=http://localhost:5173

# Postgres connection string (Neon in prod; local Postgres in dev), accessed via Drizzle ORM
DATABASE_URL=

# Deepgram (https://console.deepgram.com) — used for live speech-to-text streaming
DEEPGRAM_API_KEY=

# Anthropic (https://console.anthropic.com) — used for Kalli's conversational replies
ANTHROPIC_API_KEY=
# Model ID to use for replies. Optional — defaults to claude-sonnet-5.
LLM_MODEL=
# Model ID to use for the error-analysis pass. Optional — defaults to claude-haiku-4-5-20251001.
ANALYSIS_LLM_MODEL=

# TTS provider: "kokoro" (default, via DeepInfra), "chatterbox-turbo" (also via DeepInfra — needs
# ffmpeg on PATH, see apps/server/Dockerfile; installed in prod, `brew install ffmpeg` locally;
# NOTE: DeepInfra's own inference is ~8s/sentence, too slow for live conversation — kept only for
# non-live use), "inworld" (UNVERIFIED — built from Inworld's docs, no live key tested against it
# yet), or "elevenlabs". Manual rollback switch — flip to "elevenlabs" if the active option's
# quality/reliability is a problem in production.
TTS_PROVIDER=

# DeepInfra (https://deepinfra.com) — hosts the Kokoro-82M and Chatterbox-turbo open-weight TTS
# models used to synthesize Kalli's spoken replies. Required unless TTS_PROVIDER is elevenlabs or
# inworld.
DEEPINFRA_API_KEY=
# Kokoro voice ID to use for Kalli. Optional — defaults to "af_heart". Only read when
# TTS_PROVIDER=kokoro (Chatterbox-turbo has no named preset voices). See
# apps/server/src/scripts/compareTts.ts to compare candidate voices.
DEEPINFRA_VOICE_ID=

# ElevenLabs (https://elevenlabs.io) — only read when TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=
# Voice ID to use for Kalli. Optional — defaults to the "Rachel" premade voice.
ELEVENLABS_VOICE_ID=

# Inworld (https://platform.inworld.ai) — only read when TTS_PROVIDER=inworld. Sign up, then
# generate a key under Settings > API Keys and paste the "Basic (Base64)" credential here as-is.
INWORLD_API_KEY=
# Voice to use for Kalli. Optional — defaults to "Sarah". Browse voices in the Inworld Portal's
# TTS Playground.
INWORLD_VOICE_ID=
# Model ID. Optional — defaults to "inworld-tts-2-flash" (cheapest/fastest tier, evaluated for
# cost). "inworld-tts-2" additionally supports natural-language delivery steering, at a higher
# price — see docs.inworld.ai/tts/tts for the current comparison.
INWORLD_MODEL=

# Pronunciation-scoring service (built separately, not part of the main repo) — used for live
# pronunciation error detection. See apps/pronunciation-service/ for the service implementation.
PRONUNCIATION_SERVICE_URL=

# Max minutes a session may run before the server auto-ends it. Optional — defaults to 15.
MAX_SESSION_DURATION_MINUTES=
# Soft cap on sessions a single user may start per UTC day. Optional — defaults to 10.
DAILY_SESSION_CAP=

# Cloudflare R2 (https://dash.cloudflare.com, R2 tab) — stores flagged-error audio clips.
# Create a bucket and an R2 API token scoped to it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
