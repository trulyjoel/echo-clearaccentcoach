{
  "name": "callie",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @callie/server dev",
    "dev:web": "pnpm --filter @callie/web dev",
    "build": "pnpm -r build",
    "lint": "oxlint apps packages",
    "format": "oxfmt apps packages",
    "format:check": "oxfmt --check apps packages",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "oxlint": "1.74.0",
    "oxfmt": "0.59.0",
    "typescript": "7.0.2"
  }
}
